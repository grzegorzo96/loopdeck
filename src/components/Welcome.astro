---
import SiteHeader from "@/components/SiteHeader.astro";

const user = Astro.locals.user;
const todayLabel = new Date().toLocaleDateString("en-GB", {
  weekday: "long",
  day: "numeric",
  month: "long",
});
---

<div class="flex min-h-screen flex-col">
  <SiteHeader />

  <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col px-4 py-12 sm:px-6 sm:py-16 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16">
      <div class="max-w-xl">
        <h1 class="font-serif text-5xl leading-[1.05] font-semibold tracking-tight text-foreground sm:text-6xl lg:text-7xl">
          You get three today.
        </h1>
        <p class="mt-6 max-w-[38ch] text-lg leading-relaxed text-muted-foreground sm:text-xl">
          Loopdeck is a todo list with a hard stop. Pick three things. Everything else waits until a new day.
        </p>

        {user ? (
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="/dashboard"
              class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-6 text-base font-medium text-primary-foreground transition-colors hover:bg-[var(--forest-deep)]"
            >
              Open today&apos;s focus
            </a>
          </div>
        ) : (
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="/auth/signup"
              class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-6 text-base font-medium text-primary-foreground transition-colors hover:bg-[var(--forest-deep)]"
            >
              Create a free account
            </a>
            <a
              href="/auth/signin"
              class="inline-flex h-12 items-center justify-center px-2 text-base text-muted-foreground transition-colors hover:text-foreground"
            >
              Already have one? Sign in
            </a>
          </div>
        )}
      </div>

      <aside
        class="bg-card text-card-foreground border-border shadow-[0_1px_0_rgb(30_35_32_/_0.06)] rounded-sm border p-6 sm:p-8"
        aria-hidden="true"
      >
        <p class="font-serif text-lg text-foreground">{todayLabel}</p>
        <p class="mt-1 text-sm text-muted-foreground">Today&apos;s page</p>
        <ol class="mt-8 space-y-5">
          <li class="flex items-end gap-3">
            <span class="font-serif w-5 text-lg text-muted-foreground">1</span>
            <span class="border-border mb-1 h-px flex-1 border-b border-dashed"></span>
          </li>
          <li class="flex items-end gap-3">
            <span class="font-serif w-5 text-lg text-muted-foreground">2</span>
            <span class="border-border mb-1 h-px flex-1 border-b border-dashed"></span>
          </li>
          <li class="flex items-end gap-3">
            <span class="font-serif w-5 text-lg text-muted-foreground">3</span>
            <span class="border-border mb-1 h-px flex-1 border-b border-dashed"></span>
          </li>
        </ol>
        <p class="font-serif mt-10 text-base text-muted-foreground italic">The rest wait.</p>
      </aside>
    </div>

    <section class="border-border mt-20 max-w-2xl border-t pt-10 sm:mt-28">
      <p class="font-serif text-2xl leading-snug text-foreground sm:text-3xl">
        Ordinary lists reward collecting. Loopdeck rewards finishing.
      </p>
      <p class="mt-4 max-w-[52ch] leading-relaxed text-muted-foreground">
        Completing a task does not free a slot. Three is the whole day. Unfinished work comes back tomorrow — nothing is
        deleted. No projects, tags, or calendar. If you need a fourth, you swap one out on purpose.
      </p>
      {!user && (
        <p class="mt-8">
          <a href="/auth/signup" class="font-medium text-primary underline-offset-4 hover:underline">
            Start with an empty page
          </a>
        </p>
      )}
    </section>
  </main>

  <footer class="border-border mt-auto border-t">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-5 text-sm text-muted-foreground sm:px-6">
      <span>Loopdeck</span>
      <a href="/privacy" class="hover:text-foreground">
        Privacy policy
      </a>
    </div>
  </footer>
</div>
