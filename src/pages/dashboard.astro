---
import Layout from "@/layouts/Layout.astro";
import { TaskApp } from "@/components/tasks/TaskApp";
import { DeleteAccountSection } from "@/components/tasks/DeleteAccountSection";

const { user } = Astro.locals;
---

<Layout title="Loopdeck">
  <div class="bg-cosmic min-h-screen text-white">
    <header class="border-b border-white/10 px-4 py-4">
      <div class="mx-auto flex max-w-2xl items-center justify-between">
        <div>
          <h1 class="text-xl font-bold">Loopdeck</h1>
          <p class="text-sm text-white/60">{user?.email}</p>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>
    </header>
    <main class="space-y-8 pb-12">
      <TaskApp client:load />
      <div class="mx-auto max-w-2xl px-4">
        <DeleteAccountSection client:load />
      </div>
    </main>
  </div>
</Layout>
