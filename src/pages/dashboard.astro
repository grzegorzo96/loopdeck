---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { TaskApp } from "@/components/tasks/TaskApp";
import { DeleteAccountSection } from "@/components/tasks/DeleteAccountSection";

const user = Astro.locals.user;
const todayLabel = new Date().toLocaleDateString("en-GB", {
  weekday: "long",
  day: "numeric",
  month: "long",
});
---

<Layout title="Today — Loopdeck">
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main class="mx-auto w-full max-w-2xl flex-1 px-4 py-8 sm:py-10">
      <div class="mb-8">
        <p class="text-sm text-muted-foreground">{todayLabel}</p>
        <h1 class="font-serif mt-1 text-3xl font-semibold tracking-tight">Loopdeck</h1>
        <p class="mt-1 text-sm text-muted-foreground">{user?.email}</p>
      </div>
      <TaskApp client:load />
      <div class="mt-16">
        <DeleteAccountSection client:load />
      </div>
    </main>
  </div>
</Layout>
