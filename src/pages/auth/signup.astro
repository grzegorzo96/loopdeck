---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Create account — Loopdeck">
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main class="flex flex-1 items-center justify-center px-4 py-12">
      <div class="bg-card border-border w-full max-w-sm rounded-sm border p-8 shadow-[0_1px_0_rgb(30_35_32_/_0.06)]">
        <h1 class="font-serif text-3xl font-semibold tracking-tight">Create account</h1>
        <p class="mt-2 mb-6 text-sm text-muted-foreground">Three tasks. That&apos;s the whole day.</p>
        <SignUpForm serverError={error} client:load />
        <p class="mt-5 text-center text-sm text-muted-foreground">
          Already have an account?{" "}
          <a href="/auth/signin" class="font-medium text-primary underline-offset-4 hover:underline">
            Sign in
          </a>
        </p>
      </div>
    </main>
  </div>
</Layout>
