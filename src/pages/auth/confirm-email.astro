---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      heading: "You are in",
      description: "Your account has been created. Sign in and pick three things for today.",
      linkText: "Sign in",
    }
  : {
      heading: "Check your email",
      description: "We sent a confirmation link. Open it, then come back and pick three things for today.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main class="flex flex-1 items-center justify-center px-4 py-12">
      <div class="bg-card border-border w-full max-w-sm rounded-sm border p-8 text-center shadow-[0_1px_0_rgb(30_35_32_/_0.06)]">
        <h1 class="font-serif text-3xl font-semibold tracking-tight">{content.heading}</h1>
        <p class="mt-3 mb-8 text-muted-foreground">{content.description}</p>
        <a
          href="/auth/signin"
          class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-5 font-medium text-primary-foreground transition-colors hover:bg-[var(--forest-deep)]"
        >
          {content.linkText}
        </a>
      </div>
    </main>
  </div>
</Layout>
