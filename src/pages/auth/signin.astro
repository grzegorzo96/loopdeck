---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in — Loopdeck">
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main class="flex flex-1 items-center justify-center px-4 py-12">
      <div class="bg-card border-border w-full max-w-sm rounded-sm border p-8 shadow-[0_1px_0_rgb(30_35_32_/_0.06)]">
        <h1 class="font-serif text-3xl font-semibold tracking-tight">Sign in</h1>
        <p class="mt-2 mb-6 text-sm text-muted-foreground">Open today&apos;s three.</p>
        <SignInForm serverError={error} client:load />
        <p class="mt-5 text-center text-sm text-muted-foreground">
          No account yet?{" "}
          <a href="/auth/signup" class="font-medium text-primary underline-offset-4 hover:underline">
            Create one
          </a>
        </p>
      </div>
    </main>
  </div>
</Layout>
